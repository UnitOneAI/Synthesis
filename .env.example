# =============================================================================
# Synthesis — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# SECURITY: Never commit .env files with real values. See .gitignore.
# =============================================================================

# Anthropic API key for Claude-based threat analysis
# Obtain from: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini API key for Gemini-based threat analysis
# Obtain from: https://aistudio.google.com/apikey
GOOGLE_GEMINI_API_KEY=

# GitHub token for repository analysis and PR integration
# Required scopes: repo (read), pull_requests (write)
GITHUB_TOKEN=
