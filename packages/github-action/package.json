{
  "name": "@synthesis/github-action",
  "version": "1.0.0",
  "description": "AI-powered STRIDE threat modeling GitHub Action for pull requests",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "build": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "all": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@actions/exec": "^1.1.1",
    "@synthesis/core": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.1",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "@types/node": "^20.11.5"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
